// Serves the wedding guest pages at madluna.ca/w/* from the local dist/ folder.
// This is separate from the main site Worker, which deploys from GitHub. Photos never go to GitHub.
// A route on a path takes priority over the main site's custom domain, so only /w/* comes here.
// worker.js runs first on every request to check the household's password and take guest uploads.
// Deploy with: python build.py deploy  (npx cannot start inside the network-drive folder itself)
{
	"$schema": "https://unpkg.com/wrangler/config-schema.json",
	"name": "madluna-wedding",
	"main": "worker.js",
	"compatibility_date": "2026-04-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"r2_buckets": [
		{ "binding": "UPLOADS", "bucket_name": "madluna-wedding-uploads" }
	],
	"routes": [
		{ "pattern": "madluna.ca/w/*", "zone_name": "madluna.ca" }
	],
	// no public *.workers.dev copy of the photos
	"workers_dev": false,
	"preview_urls": false
}
